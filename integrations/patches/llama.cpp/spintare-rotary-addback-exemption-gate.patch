+// ggml_compute_forward_kv_mu_gate (SG2)
+
+void ggml_compute_forward_kv_mu_gate(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * k  = dst->src[0];
+    const ggml_tensor * mu = dst->src[1];
+    const ggml_tensor * x  = dst->src[2];
+    const int mode  = ggml_get_op_params_i32(dst, 0);
+    const int force = ggml_get_op_params_i32(dst, 1);
+    const int64_t D = k->ne[0], H = k->ne[1], T = k->ne[2];
+    const float * mud = (const float *) mu->data;
+    const float * xd  = (const float *) x->data;
+    float * out = (float *) dst->data;
+    for (int64_t r = params->ith; r < H*T; r += params->nth) {
+        const int64_t h = r % H, t = r / H;
+        const float * kr = (const float *) ((const char *) k->data + h*k->nb[1] + t*k->nb[2]);
+        const float * mr = mud + h*D;
+        if (mode == 0) {
+            float g;
+            if (force < 0) {
+                float dot = 0.0f;
+                for (int64_t i = 0; i < D; ++i) {
+                    dot += kr[i]*mr[i];
+                }
+                g = (dot - xd[h]) > 0.0f ? 1.0f : 0.0f;
+            } else {
+                g = force ? 1.0f : 0.0f;
+            }
+            out[h + t*H] = g;
+        } else {
+            const float g = xd[h + t*H];
+            float * o = out + (h + t*H)*D;
+            for (int64_t i = 0; i < D; ++i) {
+                o[i] = kr[i] - mr[i]*g;
+            }
+        }
+    }
+}
