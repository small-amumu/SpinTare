--- a/src/models/qwen2.cpp
+++ b/src/models/qwen2.cpp
@@ -1,4 +1,345 @@
 #include "models.h"
+#include "kv-mu.h"
+#include "llama-impl.h"
+#include "llama-model.h"
+
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <numeric>
+#include <map>
+#include <utility>
+
+// KV de-offset (experimental, env LLAMA_KV_DEBIAS=1): the selected RoPE pairs of the k_proj bias b are removed from K
+// before RoPE and KV quantization, and their score contribution q . R(p) b is added back exactly:
+//   flash attention, <= 2 queries per step: per-head KQ bias sum_j A_j (cos(p theta_j) - 1) + B_j sin(p theta_j),
+//                                           A_j = q_j b_j + q_{j+h} b_{j+h}, B_j = q_{j+h} b_j - q_j b_{j+h}; the
+//                                           dropped term sum_j A_j is the same for every key of a query (softmax
+//                                           invariant, valid because the model has no attention sinks)
+//   flash attention, larger batches:        K is rebuilt as dequant(K) + H R(p) b in F16
+//   no flash attention:                     kq_b = q . R(p) b
+// LLAMA_KV_DEBIAS_PAIRS: "auto" (default: per kv head, the fewest pairs holding 99% of the bias energy, union over
+// heads), "all", or an energy fraction in (0, 1]. LLAMA_KV_DEBIAS_PATH: force "kqbias", "kadd" or "kqb" (testing).
+// LLAMA_KV_DEBIAS_FUSED=1 (experimental): the per-head KQ bias is one GGML_OP_KQ_ROPE_BIAS per layer (u computed per
+// pair from q and the bias, c' stored as F16 scaled by 2^8 with the keys contiguous) instead of u = m q and c'^T u.
+namespace {
+
+bool kv_debias_fused() {
+    static const bool fused = getenv("LLAMA_KV_DEBIAS_FUSED") && atoi(getenv("LLAMA_KV_DEBIAS_FUSED")) != 0;
+    return fused;
+}
+
+// scale of c' for the fused op: 2^8 keeps the small entries of the F16 c' out of the subnormal range
+constexpr float kv_debias_fused_c_scale = 256.0f;
+
+struct kv_debias_layer {
+    int64_t            n_pairs = 0;
+    std::vector<float> m;    // [n_embd_head, n_embd_head, n_head_kv]: u = m q, u_j = A_j, u_{j+h} = B_j (zero outside S)
+    std::vector<float> bsub; // [n_embd_head, n_head_kv]: k bias restricted to the selected pairs
+
+    // persistent copies of m and bsub, allocated like weights; nullptr in a placeholder plan
+    ggml_tensor * m_t    = nullptr;
+    ggml_tensor * bsub_t = nullptr;
+};
+
+struct kv_debias_plan {
+    std::vector<kv_debias_layer> layers;
+    int64_t n_embd_head = 0;
+    int64_t n_head_kv   = 0;
+
+    ggml_tensor * unit_t = nullptr; // F32 [n_embd_head] = [1..1, 0..0], persistent, next to the last layer with pairs
+
+    std::vector<ggml_context *>         ctxs;
+    std::vector<ggml_backend_buffer_t> bufs;
+};
+
+// k bias tensor of a layer and the offset of its k part, or nullptr
+const ggml_tensor * kv_debias_bias_tensor(const llama_layer & layer, int64_t n_embd_head, int64_t n_head, int64_t & offs) {
+    offs = 0;
+    if (layer.wk_b != nullptr) {
+        return layer.wk_b;
+    }
+    if (layer.wqkv_b != nullptr) {
+        offs = n_embd_head*n_head; // fused bias layout [q | k | v]
+        return layer.wqkv_b;
+    }
+    return nullptr;
+}
+
+std::vector<float> kv_debias_get_bias(const llama_layer & layer, int64_t n_embd_head, int64_t n_head, int64_t n_head_kv) {
+    const int64_t n = n_embd_head*n_head_kv;
+
+    int64_t offs = 0;
+    const ggml_tensor * t = kv_debias_bias_tensor(layer, n_embd_head, n_head, offs);
+
+    std::vector<float> res;
+    if (t == nullptr) {
+        return res;
+    }
+    res.resize(n, 0.0f);
+    if (t->data == nullptr) {
+        return res; // weights not allocated (e.g. memory fitting with no_alloc): placeholder values
+    }
+    if (t->type == GGML_TYPE_F32) {
+        ggml_backend_tensor_get(t, res.data(), offs*sizeof(float), n*sizeof(float));
+    } else {
+        GGML_ASSERT(t->type == GGML_TYPE_F16);
+        std::vector<ggml_fp16_t> tmp(n);
+        ggml_backend_tensor_get(t, tmp.data(), offs*sizeof(ggml_fp16_t), n*sizeof(ggml_fp16_t));
+        ggml_fp16_to_fp32_row(tmp.data(), res.data(), n);
+    }
+    return res;
+}
+
+kv_debias_plan kv_debias_make_plan(const llama_model & model, int64_t n_embd_head, int64_t n_head, int64_t n_head_kv, bool placeholder) {
+    bool  all  = placeholder; // without the weights use all pairs, the largest graph
+    float frac = 0.99f;
+    if (const char * e = getenv("LLAMA_KV_DEBIAS_PAIRS")) {
+        if (strcmp(e, "all") == 0) {
+            all = true;
+        } else if (strcmp(e, "auto") != 0) {
+            frac = (float) atof(e);
+        }
+    }
+    GGML_ASSERT(all || (frac > 0.0f && frac <= 1.0f));
+
+    const int64_t D    = n_embd_head;
+    const int64_t half = D/2;
+
+    kv_debias_plan plan;
+    plan.layers.resize(model.layers.size());
+    plan.n_embd_head = D;
+    plan.n_head_kv   = n_head_kv;
+
+    int     n_bias_layers = 0;
+    int64_t n_pairs_sum   = 0;
+    double  kept_sum      = 0.0;
+    double  kept_min      = 1.0;
+
+    for (size_t il = 0; il < model.layers.size(); ++il) {
+        const std::vector<float> b = kv_debias_get_bias(model.layers[il], D, n_head, n_head_kv);
+        if (b.empty()) {
+            continue;
+        }
+
+        std::vector<bool> sel(half, all);
+        if (!all) {
+            for (int64_t h = 0; h < n_head_kv; ++h) {
+                const float * bh = b.data() + h*D;
+                std::vector<double> e(half);
+                double tot = 0.0;
+                for (int64_t j = 0; j < half; ++j) {
+                    e[j] = double(bh[j])*bh[j] + double(bh[j + half])*bh[j + half];
+                    tot += e[j];
+                }
+                std::vector<int64_t> ord(half);
+                std::iota(ord.begin(), ord.end(), 0);
+                std::sort(ord.begin(), ord.end(), [&](int64_t x, int64_t y) { return e[x] > e[y]; });
+                double cum = 0.0;
+                for (const int64_t j : ord) {
+                    if (cum >= frac*tot) {
+                        break;
+                    }
+                    sel[j] = true;
+                    cum += e[j];
+                }
+            }
+        }
+
+        std::vector<int64_t> pairs;
+        for (int64_t j = 0; j < half; ++j) {
+            if (sel[j]) {
+                pairs.push_back(j);
+            }
+        }
+
+        kv_debias_layer & L = plan.layers[il];
+        const int64_t ns = pairs.size();
+        L.n_pairs = ns;
+        L.m.assign(D*D*n_head_kv, 0.0f);
+        L.bsub.assign(D*n_head_kv, 0.0f);
+
+        for (const int64_t j : pairs) {
+            for (int64_t h = 0; h < n_head_kv; ++h) {
+                const float b1 = b[h*D + j];
+                const float b2 = b[h*D + j + half];
+                float * mh = L.m.data() + h*D*D;
+                mh[j*D + j]                 =  b1; // A_j = q_j b_j + q_{j+h} b_{j+h}
+                mh[j*D + j + half]          =  b2;
+                mh[(j + half)*D + j]        = -b2; // B_j = q_{j+h} b_j - q_j b_{j+h}
+                mh[(j + half)*D + j + half] =  b1;
+                L.bsub[h*D + j]        = b1;
+                L.bsub[h*D + j + half] = b2;
+            }
+        }
+
+        double e_all  = 0.0;
+        double e_kept = 0.0;
+        for (int64_t i = 0; i < D*n_head_kv; ++i) {
+            e_all  += double(b[i])*b[i];
+            e_kept += double(L.bsub[i])*L.bsub[i];
+        }
+        const double kept = e_all > 0.0 ? e_kept/e_all : 1.0;
+        n_bias_layers++;
+        n_pairs_sum += ns;
+        kept_sum    += kept;
+        kept_min     = std::min(kept_min, kept);
+    }
+
+    if (placeholder) {
+        return plan;
+    }
+    if (n_bias_layers > 0) {
+        LLAMA_LOG_INFO("%s: KV de-offset: %d layers with k bias, pairs/layer %.1f of %lld, kept energy mean %.4f min %.4f\n",
+                __func__, n_bias_layers, double(n_pairs_sum)/n_bias_layers, (long long) half, kept_sum/n_bias_layers, kept_min);
+    } else {
+        LLAMA_LOG_WARN("%s: KV de-offset enabled but the model has no k bias\n", __func__);
+    }
+
+    return plan;
+}
+
+// copy the plan tensors to persistent buffers (one per layer buffer type, flagged as weights) so that the graphs use
+// them like weights instead of uploading them as graph inputs at every step (each input upload is a synchronous copy)
+void kv_debias_upload(kv_debias_plan & plan, const llama_model & model) {
+    const int64_t D = plan.n_embd_head;
+
+    std::map<ggml_backend_buffer_type_t, ggml_context *> ctx_map;
+    const auto ctx_for_buft = [&](ggml_backend_buffer_type_t buft) -> ggml_context * {
+        auto it = ctx_map.find(buft);
+        if (it != ctx_map.end()) {
+            return it->second;
+        }
+        ggml_init_params params = {
+            /*.mem_size   =*/ (2*plan.layers.size() + 1)*ggml_tensor_overhead(),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        ggml_context * ctx = ggml_init(params);
+        GGML_ASSERT(ctx != nullptr);
+        ctx_map[buft] = ctx;
+        plan.ctxs.push_back(ctx);
+        return ctx;
+    };
+
+    // unit (and so the per-graph c' computation) goes next to the last layer with pairs: with partial offload the
+    // last layers are the offloaded ones
+    for (size_t il = plan.layers.size(); il-- > 0;) {
+        kv_debias_layer & L = plan.layers[il];
+        if (L.n_pairs == 0) {
+            continue;
+        }
+        ggml_context * ctx = ctx_for_buft(model.select_buft(il));
+        L.m_t    = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, D, D, plan.n_head_kv);
+        L.bsub_t = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, D, plan.n_head_kv, 1);
+        ggml_format_name(L.m_t,    "kv_debias_m-%zu",    il);
+        ggml_format_name(L.bsub_t, "kv_debias_bsub-%zu", il);
+        if (plan.unit_t == nullptr) {
+            plan.unit_t = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, D);
+            ggml_set_name(plan.unit_t, "kv_debias_unit");
+        }
+    }
+
+    for (const auto & it : ctx_map) {
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(it.second, it.first);
+        GGML_ASSERT(buf != nullptr && "KV de-offset: failed to allocate the plan buffer");
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        plan.bufs.push_back(buf);
+    }
+
+    for (kv_debias_layer & L : plan.layers) {
+        if (L.m_t == nullptr) {
+            continue;
+        }
+        ggml_backend_tensor_set(L.m_t,    L.m.data(),    0, ggml_nbytes(L.m_t));
+        ggml_backend_tensor_set(L.bsub_t, L.bsub.data(), 0, ggml_nbytes(L.bsub_t));
+        std::vector<float>().swap(L.m); // the host copy is no longer needed
+    }
+    if (plan.unit_t != nullptr) {
+        std::vector<float> e(D, 0.0f);
+        std::fill(e.begin(), e.begin() + D/2, kv_debias_fused() ? kv_debias_fused_c_scale : 1.0f);
+        ggml_backend_tensor_set(plan.unit_t, e.data(), 0, ggml_nbytes(plan.unit_t));
+    }
+}
+
+// frees the plan buffers (not called at process exit: backends may be gone by then)
+void kv_debias_free(kv_debias_plan & plan) {
+    for (ggml_backend_buffer_t buf : plan.bufs) {
+        ggml_backend_buffer_free(buf);
+    }
+    for (ggml_context * ctx : plan.ctxs) {
+        ggml_free(ctx);
+    }
+    plan = kv_debias_plan();
+}
+
+// note: cached per (model address, k bias data address) for the lifetime of the process (experimental limitation):
+//       entries are never evicted, so every loaded model keeps its plan buffers (~7 MiB for Qwen2.5-7B), and a
+//       different model with the same shapes loaded at both reused addresses would get the old plan (only shapes are
+//       checked); the clean fix is a plan owned by llama_model. Models whose weights are not allocated (memory
+//       fitting) get a placeholder plan with the same shapes as "all"
+const kv_debias_plan & kv_debias_get_plan(const llama_model & model, int64_t n_embd_head, int64_t n_head, int64_t n_head_kv) {
+    static std::mutex mtx;
+    static std::map<std::pair<const llama_model *, const void *>, kv_debias_plan> plans;
+    static std::map<const llama_model *, kv_debias_plan> placeholders;
+
+    const auto matches = [&](const kv_debias_plan & plan) {
+        return plan.layers.size() == model.layers.size() && plan.n_embd_head == n_embd_head && plan.n_head_kv == n_head_kv;
+    };
+
+    const void * key = nullptr;
+    for (const auto & layer : model.layers) {
+        int64_t offs = 0;
+        if (const ggml_tensor * t = kv_debias_bias_tensor(layer, n_embd_head, n_head, offs)) {
+            key = t->data;
+            break;
+        }
+    }
+
+    std::lock_guard<std::mutex> lock(mtx);
+    if (key == nullptr) {
+        auto & res = placeholders[&model];
+        if (!matches(res)) {
+            res = kv_debias_make_plan(model, n_embd_head, n_head, n_head_kv, true);
+        }
+        return res;
+    }
+    auto & res = plans[{&model, key}];
+    if (!matches(res)) {
+        kv_debias_free(res);
+        res = kv_debias_make_plan(model, n_embd_head, n_head, n_head_kv, false);
+        kv_debias_upload(res, model);
+    }
+    return res;
+}
+
+// plan tensors without a persistent copy (placeholder plans, or unit in a plan without any selected pair) are graph
+// inputs, zeroed here (no correction) in case such a graph is ever computed; normal plans use the persistent tensors,
+// so their only per-step debias input is kv_pos
+class llm_graph_input_kv_debias_zero : public llm_graph_input_i {
+public:
+    void set_input(const llama_ubatch * ubatch) override {
+        GGML_UNUSED(ubatch);
+        for (ggml_tensor * t : tensors) {
+            if (t->buffer) {
+                ggml_backend_tensor_memset(t, 0, 0, ggml_nbytes(t));
+            }
+        }
+    }
+
+    bool can_reuse(const llm_graph_params & params) override {
+        GGML_UNUSED(params);
+        return true;
+    }
+
+    std::vector<ggml_tensor *> tensors;
+};
+
+} // namespace
 
