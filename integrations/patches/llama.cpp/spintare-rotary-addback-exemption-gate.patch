+// GGML_OP_KV_MU_GATE (SG2)
+struct test_kv_mu_gate : public test_case {
+    const int64_t D, H, T;
+    const int mode;  // 0 gate, 1 apply
+    const bool perm; // k as a permuted view
+    std::string vars() override {
+        return VARS_TO_STR5(D, H, T, mode, perm);
+    }
+    test_kv_mu_gate(int64_t D = 128, int64_t H = 8, int64_t T = 2, int mode = 0, bool perm = false)
+        : D(D), H(H), T(T), mode(mode), perm(perm) {}
+    void initialize_tensors(ggml_context * ctx) override {
+        std::mt19937 rng(4321);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(ggml_get_name(t), "half") == 0) {
+                // thresholds spread around the typical dot so that both decisions occur
+                std::vector<float> v(ggml_nelements(t));
+                std::uniform_real_distribution<float> dist(-2.0f, 2.0f);
+                for (auto & x : v) { x = dist(rng); }
+                ggml_backend_tensor_set(t, v.data(), 0, v.size()*sizeof(float));
+            } else if (strcmp(ggml_get_name(t), "g") == 0) {
+                std::vector<float> v(ggml_nelements(t));
+                std::uniform_int_distribution<int> dist(0, 1);
+                for (auto & x : v) { x = (float) dist(rng); }
+                ggml_backend_tensor_set(t, v.data(), 0, v.size()*sizeof(float));
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * k;
+        if (perm) {
+            k = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, D, T, H);
+            ggml_set_name(k, "k");
+            k = ggml_permute(ctx, k, 0, 2, 1, 3); // [D, H, T]
+        } else {
+            k = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, D, H, T);
+            ggml_set_name(k, "k");
+        }
+        ggml_tensor * mu = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, D, H);
+        ggml_set_name(mu, "mu");
+        ggml_tensor * out;
+        if (mode == 0) {
+            ggml_tensor * half = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1, H);
+            ggml_set_name(half, "half");
+            out = ggml_kv_mu_gate(ctx, k, mu, half, -1);
+        } else {
+            ggml_tensor * g = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, H, T);
+            ggml_set_name(g, "g");
+            out = ggml_kv_mu_apply(ctx, k, mu, g);
+        }
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
