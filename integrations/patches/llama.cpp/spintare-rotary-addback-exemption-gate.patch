+
+struct ggml_tensor * ggml_kq_rope_bias(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * b,
+        struct ggml_tensor  * c,
+        float                 scale) {
+    GGML_ASSERT(q->type == GGML_TYPE_F32);
+    GGML_ASSERT(b->type == GGML_TYPE_F32);
+    GGML_ASSERT(c->type == GGML_TYPE_F32 || c->type == GGML_TYPE_F16);
+    GGML_ASSERT(q->ne[0] % 2 == 0);
+    GGML_ASSERT(b->ne[0] == q->ne[0] && c->ne[1] == q->ne[0]);
+    GGML_ASSERT(q->ne[1] % b->ne[1] == 0);
+    GGML_ASSERT(b->ne[2] == 1 && b->ne[3] == 1);
+    GGML_ASSERT(c->ne[2] == 1 && q->ne[3] % c->ne[3] == 0);
+    GGML_ASSERT(q->nb[0] == ggml_type_size(q->type));
+    GGML_ASSERT(b->nb[0] == ggml_type_size(b->type));
+    GGML_ASSERT(c->nb[0] == ggml_type_size(c->type));
+
+    const int64_t ne[4] = { c->ne[0], q->ne[2], q->ne[1], q->ne[3] };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+
+    ggml_set_op_params_f32(result, 0, scale);
+
+    result->op     = GGML_OP_KQ_ROPE_BIAS;
+    result->src[0] = q;
+    result->src[1] = b;
+    result->src[2] = c;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_kq_rope_bias_pos(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * b,
+        struct ggml_tensor  * pos,
+        float                 freq_base,
+        float                 freq_scale,
+        float                 scale) {
+    GGML_ASSERT(q->type == GGML_TYPE_F32);
+    GGML_ASSERT(b->type == GGML_TYPE_F32);
+    GGML_ASSERT(pos->type == GGML_TYPE_I32 && ggml_is_vector(pos) && ggml_is_contiguous(pos));
+    GGML_ASSERT(q->ne[0] % 2 == 0);
+    GGML_ASSERT(b->ne[0] == q->ne[0]);
+    GGML_ASSERT(q->ne[1] % b->ne[1] == 0);
+    GGML_ASSERT(b->ne[2] == 1 && b->ne[3] == 1);
+    GGML_ASSERT(q->nb[0] == ggml_type_size(q->type));
+    GGML_ASSERT(b->nb[0] == ggml_type_size(b->type));
+
+    const int64_t ne[4] = { pos->ne[0], q->ne[2], q->ne[1], q->ne[3] };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+
+    // theta_scale on the host with powf, as the CUDA rope launcher computes it
+    const float theta_scale = powf(freq_base, -2.0f/(float) q->ne[0]);
+    ggml_set_op_params_f32(result, 0, scale);
+    ggml_set_op_params_f32(result, 1, theta_scale);
+    ggml_set_op_params_f32(result, 2, freq_scale);
+
+    result->op     = GGML_OP_KQ_ROPE_BIAS;
+    result->src[0] = q;
+    result->src[1] = b;
+    result->src[2] = pos;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_kv_mu_gate(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * k,
+        struct ggml_tensor  * mu,
+        struct ggml_tensor  * half,
+        int                   force) {
+    GGML_ASSERT(k->type == GGML_TYPE_F32 && mu->type == GGML_TYPE_F32 && half->type == GGML_TYPE_F32);
+    GGML_ASSERT(mu->ne[0] == k->ne[0] && mu->ne[1] == k->ne[1] && ggml_is_contiguous(mu) && ggml_nrows(mu) == mu->ne[1]);
+    GGML_ASSERT(half->ne[0] == 1 && half->ne[1] == k->ne[1] && ggml_is_contiguous(half));
+    GGML_ASSERT(k->ne[3] == 1 && k->nb[0] == sizeof(float));
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, k->ne[1], k->ne[2]);
+    ggml_set_op_params_i32(result, 0, 0);     // mode 0: gate
+    ggml_set_op_params_i32(result, 1, force); // -1 rule, 1 centre, 0 exempt
+    result->op     = GGML_OP_KV_MU_GATE;
+    result->src[0] = k;
+    result->src[1] = mu;
+    result->src[2] = half;
+    return result;
+}
