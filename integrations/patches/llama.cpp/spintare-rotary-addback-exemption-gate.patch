+
+    GGML_TENSOR_LOCALS(int64_t, neq, q, ne)
+    GGML_TENSOR_LOCALS(size_t,  nbq, q, nb)
+    GGML_TENSOR_LOCALS(size_t,  nbb, b, nb)
+    GGML_TENSOR_LOCALS(int64_t, nec, c, ne)
+    GGML_TENSOR_LOCALS(size_t,  nbc, c, nb)
+    GGML_TENSOR_LOCALS(size_t,  nb, dst, nb)
+
+    GGML_ASSERT(nb0 == sizeof(float));
+
+    constexpr int64_t CH = GGML_KQ_ROPE_BIAS_CPU_CHUNK;
+
+    const int64_t D     = neq0;
+    const int64_t half  = D/2;
+    const int64_t n_kv  = nec0;
+    const int64_t gqa   = neq1/b->ne[1];
+    const float   scale = ggml_get_op_params_f32(dst, 0);
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    // per thread: one block of c converted to F32 ([D][CH]) and u ([D])
+    float * cf = (float *) params->wdata + ith*(D*CH + D + CACHE_LINE_SIZE_F32);
+    float * u  = cf + D*CH;
+
+    // blocks of CH keys, per stream
+    const int64_t nchunk = (n_kv + CH - 1)/CH;
+
+    for (int64_t blk = ith; blk < nchunk*neq3; blk += nth) {
+        const int64_t i3 = blk/nchunk;
+        const int64_t p0 = (blk % nchunk)*CH;
+        const int64_t np = MIN(CH, n_kv - p0);
+
+        const char * c_base = (const char *) c->data + (i3 % nec3)*nbc3 + p0*nbc0;
+        if (c->type == GGML_TYPE_I32) {
+            // position form: c from the positions, theta as the CUDA NEOX rope computes it
+            const float theta_scale = ggml_get_op_params_f32(dst, 1);
+            const float freq_scale  = ggml_get_op_params_f32(dst, 2);
+            const int32_t * pp = (const int32_t *) c->data + p0;
+            for (int64_t j = 0; j < half; ++j) {
+                const float tj = powf(theta_scale, (float) j);
+                for (int64_t i = 0; i < np; ++i) {
+                    const float theta = freq_scale*((float) pp[i]*tj);
+                    cf[j*CH + i]          = cosf(theta) - 1.0f;
+                    cf[(j + half)*CH + i] = sinf(theta);
+                }
+            }
+        }
+        for (int64_t k = 0; c->type != GGML_TYPE_I32 && k < D; ++k) {
+            if (c->type == GGML_TYPE_F16) {
+                ggml_cpu_fp16_to_fp32((const ggml_fp16_t *) (c_base + k*nbc1), cf + k*CH, np);
+            } else {
+                memcpy(cf + k*CH, c_base + k*nbc1, np*sizeof(float));
+            }
+        }
+
+        for (int64_t h = 0; h < neq1; ++h) {
+            const float * bv = (const float *) ((const char *) b->data + (h/gqa)*nbb1);
+            for (int64_t t = 0; t < neq2; ++t) {
+                const float * qv = (const float *) ((const char *) q->data + h*nbq1 + t*nbq2 + i3*nbq3);
+                for (int64_t j = 0; j < half; ++j) {
+                    u[j]        = qv[j]*bv[j] + qv[j + half]*bv[j + half];
+                    u[j + half] = qv[j + half]*bv[j] - qv[j]*bv[j + half];
+                }
+
+                float * out = (float *) ((char *) dst->data + t*nb1 + h*nb2 + i3*nb3) + p0;
+                memset(out, 0, np*sizeof(float));
+                for (int64_t k = 0; k < D; ++k) {
+                    ggml_vec_mad_f32(np, out, cf + k*CH, u[k]);
+                }
+                ggml_vec_scale_f32(np, out, scale);
+                if (dst->src[3] != nullptr) {
+                    // gated position form: an exempt key (gate < 0.5) gets -scale * sum_{j < D/2} A_j
+                    GGML_ASSERT(c->type == GGML_TYPE_I32);
+                    const ggml_tensor * gt = dst->src[3];
+                    float sa = 0.0f;
+                    for (int64_t j = 0; j < half; ++j) {
+                        sa += u[j];
+                    }
+                    const char * gb = (const char *) gt->data + (h/gqa)*gt->nb[0];
+                    for (int64_t i = 0; i < np; ++i) {
+                        if (*(const float *) (gb + (p0 + i)*gt->nb[1]) < 0.5f) {
+                            out[i] = -scale*sa;
+                        }
+                    }
+                }
+            }
+        }
+    }
 }
