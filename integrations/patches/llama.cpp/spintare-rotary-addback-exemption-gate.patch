+    GGML_ASSERT(g->ne[0] == 1 && g->ne[1] == k->ne[1] && g->ne[2] == k->ne[2] && ggml_is_contiguous(g));
+    GGML_ASSERT(k->ne[3] == 1 && k->nb[0] == sizeof(float));
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k->ne[0], k->ne[1], k->ne[2]);
+    ggml_set_op_params_i32(result, 0, 1);     // mode 1: apply
+    result->op     = GGML_OP_KV_MU_GATE;
+    result->src[0] = k;
+    result->src[1] = mu;
+    result->src[2] = g;
+    return result;
+}
+
+struct ggml_tensor * ggml_kq_rope_bias_pos_gated(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * b,
+        struct ggml_tensor  * pos,
+        struct ggml_tensor  * gate,
+        float                 freq_base,
+        float                 freq_scale,
+        float                 scale) {
+    GGML_ASSERT(gate->type == GGML_TYPE_F32 && gate->nb[0] == sizeof(float));
+    GGML_ASSERT(gate->ne[0] == b->ne[1] && gate->ne[1] == pos->ne[0] && gate->ne[2] == 1 && gate->ne[3] == 1);
+    struct ggml_tensor * result = ggml_kq_rope_bias_pos(ctx, q, b, pos, freq_base, freq_scale, scale);
+    result->src[3] = gate;
+    return result;
+}
