--- /dev/null
+++ b/ggml/src/ggml-cuda/kq-rope-bias.cu
@@ -0,0 +1,633 @@
+#include "kq-rope-bias.cuh"
+#include "reduce_rows.cuh"
+
+// GGML_OP_KQ_ROPE_BIAS: dst[p, col] = scale * sum_k c[p, k] u[k, col], u computed per RoPE pair from q and b.
+// A small GEMM (M = n_kv, N = n_tokens*n_head, K = D) done with F32 FMAs: each block computes u for its columns into
+// shared memory once, then every lane owns KPT consecutive keys and NCW columns, streaming c (keys contiguous) from
+// global memory and reading u as warp broadcasts.
+
+static constexpr int KQRB_NCW = 8; // columns per warp
+
+template <typename c_t, int KPT>
+static __device__ __forceinline__ void kqrb_load(const c_t * src, float * dst) {
+    if constexpr (std::is_same_v<c_t, half>) {
+        if constexpr (KPT == 4) {
+            const uint2 v = *(const uint2 *) src;
+            const float2 f0 = __half22float2(*(const half2 *) &v.x);
+            const float2 f1 = __half22float2(*(const half2 *) &v.y);
+            dst[0] = f0.x; dst[1] = f0.y; dst[2] = f1.x; dst[3] = f1.y;
+        } else {
+            static_assert(KPT == 1, "bad KPT");
+            dst[0] = __half2float(src[0]);
+        }
+    } else {
+        if constexpr (KPT == 4) {
+            const float4 v = *(const float4 *) src;
+            dst[0] = v.x; dst[1] = v.y; dst[2] = v.z; dst[3] = v.w;
+        } else {
+            static_assert(KPT == 1, "bad KPT");
+            dst[0] = src[0];
+        }
+    }
+}
+
+// block: NWC warps along the columns (KQRB_NCW each) x NWK warps along the keys (32*KPT each); UNROLL: k steps per
+// unrolled group, i.e. how many loads of c a lane has in flight (the k loop is a chain of D/UNROLL memory round trips)
+template <typename c_t, int KPT, int NWC, int NWK, int UNROLL>
+__launch_bounds__(WARP_SIZE*NWC*NWK)
+static __global__ void kq_rope_bias_kernel(
+        const float * q_ptr, const float * b_ptr, const c_t * c_ptr, float * dst_ptr,
+        const int D, const int n_kv, const int n_tokens, const int ncols, const int gqa,
+        const int64_t sq1, const int64_t sq2, const int64_t sq3, const int64_t sb1,
+        const int64_t sc1, const int64_t sc3, const int nec3,
+        const int64_t s1, const int64_t s2, const int64_t s3, const float scale) {
+    constexpr int NCB = NWC*KQRB_NCW; // columns per block
+    constexpr int LDU = NCB + 4;      // row stride of u in shared memory, keeps the float4 reads aligned
+
+    // __restrict__ only inside the body (it must not change the kernel signature between the host and device passes)
+    const float * GGML_CUDA_RESTRICT q   = q_ptr;
+    const float * GGML_CUDA_RESTRICT b   = b_ptr;
+    const c_t   * GGML_CUDA_RESTRICT c   = c_ptr;
+    float       * GGML_CUDA_RESTRICT dst = dst_ptr;
+
+    extern __shared__ __align__(16) float u_s[]; // [D][LDU]
+
+    const int lane = threadIdx.x;
+    const int wc   = threadIdx.y % NWC;
+    const int wk   = threadIdx.y / NWC;
+    const int col0 = blockIdx.x*NCB;
+    const int i3   = blockIdx.z;
+    const int half = D/2;
+
+    ggml_cuda_pdl_sync();
+
+    // u of the block's columns (column col = t + n_tokens*h), consecutive threads read consecutive dimensions of q
+    for (int i = threadIdx.y*WARP_SIZE + lane; i < D*NCB; i += WARP_SIZE*NWC*NWK) {
+        const int cl  = i / D;
+        const int k   = i - cl*D;
+        const int col = col0 + cl;
+        float uk = 0.0f;
+        if (col < ncols) {
+            const int h = col / n_tokens;
+            const int t = col - h*n_tokens;
+            const float * qv = q + h*sq1 + t*sq2 + i3*sq3;
+            const float * bv = b + (h/gqa)*sb1;
+            const int j = k < half ? k : k - half;
+            const float q1 = qv[j];
+            const float q2 = qv[j + half];
+            const float b1 = bv[j];
+            const float b2 = bv[j + half];
+            uk = k < half ? q1*b1 + q2*b2 : q2*b1 - q1*b2;
+        }
+        u_s[k*LDU + cl] = uk;
+    }
+    __syncthreads();
+
+    const int p0 = (blockIdx.y*NWK + wk)*(WARP_SIZE*KPT) + lane*KPT; // n_kv % KPT == 0 for KPT > 1
+    if (p0 >= n_kv) {
+        return;
+    }
+
+    float acc[KPT][KQRB_NCW];
+#pragma unroll
+    for (int r = 0; r < KPT; ++r) {
+#pragma unroll
+        for (int cl = 0; cl < KQRB_NCW; ++cl) {
+            acc[r][cl] = 0.0f;
+        }
+    }
+
+    const c_t   * cp = c + (i3 % nec3)*sc3 + p0;
+    const float * us = u_s + wc*KQRB_NCW;
+
+#pragma unroll UNROLL
+    for (int k = 0; k < D; ++k) {
+        float cv[KPT];
+        kqrb_load<c_t, KPT>(cp + k*sc1, cv);
+        const float4 u0 = *(const float4 *) (us + k*LDU);
+        const float4 u1 = *(const float4 *) (us + k*LDU + 4);
+#pragma unroll
+        for (int r = 0; r < KPT; ++r) {
+            acc[r][0] += cv[r]*u0.x;
+            acc[r][1] += cv[r]*u0.y;
+            acc[r][2] += cv[r]*u0.z;
+            acc[r][3] += cv[r]*u0.w;
+            acc[r][4] += cv[r]*u1.x;
+            acc[r][5] += cv[r]*u1.y;
+            acc[r][6] += cv[r]*u1.z;
+            acc[r][7] += cv[r]*u1.w;
+        }
+    }
+
+    ggml_cuda_pdl_lc();
+
+#pragma unroll
+    for (int cl = 0; cl < KQRB_NCW; ++cl) {
+        const int col = col0 + wc*KQRB_NCW + cl;
+        if (col >= ncols) {
+            break;
+        }
+        const int h = col / n_tokens;
+        const int t = col - h*n_tokens;
+        float * out = dst + t*s1 + h*s2 + i3*s3 + p0;
+        if constexpr (KPT == 4) {
+            *(float4 *) out = make_float4(scale*acc[0][cl], scale*acc[1][cl], scale*acc[2][cl], scale*acc[3][cl]);
+        } else {
+#pragma unroll
+            for (int r = 0; r < KPT; ++r) {
+                out[r] = scale*acc[r][cl];
+            }
+        }
+    }
+}
+
+template <typename c_t, int KPT, int NWC, int UNROLL>
+static void kq_rope_bias_launch(
+        const float * q, const float * b, const c_t * c, float * dst,
+        const int D, const int n_kv, const int n_tokens, const int ncols, const int gqa, const int ne3,
+        const int64_t sq1, const int64_t sq2, const int64_t sq3, const int64_t sb1,
+        const int64_t sc1, const int64_t sc3, const int nec3,
+        const int64_t s1, const int64_t s2, const int64_t s3, const float scale, cudaStream_t stream) {
+    constexpr int NWK = NWC >= 4 ? 2 : 8/NWC;
+    constexpr int NCB = NWC*KQRB_NCW;
+
+    const int64_t nby = (n_kv + NWK*WARP_SIZE*KPT - 1) / (NWK*WARP_SIZE*KPT);
+    GGML_ASSERT(nby <= 65535 && ne3 <= 65535);
+
+    const dim3 grid((ncols + NCB - 1) / NCB, nby, ne3);
+    const dim3 block(WARP_SIZE, NWC*NWK, 1);
+    const size_t nbytes_shared = size_t(D)*(NCB + 4)*sizeof(float);
+
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid, block, nbytes_shared, stream);
+    ggml_cuda_kernel_launch(kq_rope_bias_kernel<c_t, KPT, NWC, NWK, UNROLL>, launch_params,
+        q, b, c, dst, D, n_kv, n_tokens, ncols, gqa, sq1, sq2, sq3, sb1, sc1, sc3, nec3, s1, s2, s3, scale);
+}
+
+// Position form: one lane per key, NC columns per warp (all columns of the block), u of the block in shared memory.
+// c'[p, k] is evaluated in the lane: cos(theta_j) - 1 for k = j < D/2, then sin(theta_j) for k = j + D/2, in the order
+// k = 0..D-1 of the table kernel. theta_j = freq_scale * (pos * theta_scale^j) with theta_scale^j = powf(theta_scale, j)
+// on the device and cosf / sinf under the flags of this file, as rope_neox evaluates them (ggml_rope_ext then
+// ggml_sub of the unit vector: cos(theta) * 1 - 0 * sin(theta) - 1).
+// v4 (SG1): v3 plus an optional per-(cell, KV head) gate; an exempt key (gate < 0.5) gets -sum_j A_j, the
+// per-query constant the add-back drops for every key. v3: NWK warps along the keys x NS warps along the rotary pairs; each lane holds KPT keys (stride 32, so the position
+// loads and the bias stores stay coalesced). u of the block's NC columns is computed per (column, pair) into shared
+// memory once per block and reused by NWK*32*KPT keys. The NS partial sums of a key are added in shared memory in the
+// order ws = 0..NS-1. c'[p, k] is evaluated in the lane as in rope_neox: theta_j = freq_scale * (pos * powf(theta_scale,
+// j)), then cosf(theta) - 1 (k = j) and sinf(theta) (k = j + D/2).
+template <int NC, int KPT, int NWK, int NS>
+__launch_bounds__(WARP_SIZE*NWK*NS)
+static __global__ void kq_rope_bias_pos_kernel(
+        const float * q_ptr, const float * b_ptr, const int32_t * pos_ptr, float * dst_ptr,
+        const int D, const int n_kv, const int n_tokens, const int ncols, const int gqa,
+        const int64_t sq1, const int64_t sq2, const int64_t sq3, const int64_t sb1,
+        const int64_t s1, const int64_t s2, const int64_t s3,
+        const float theta_scale, const float freq_scale, const float scale,
+        const float * gate_ptr, const int64_t sg1) {
+    constexpr int LDU = NC + 4;
+    constexpr int LDR = NC + 1;
+    constexpr int KPB = NWK*WARP_SIZE*KPT; // keys per block
+
+    const float   * GGML_CUDA_RESTRICT q   = q_ptr;
+    const float   * GGML_CUDA_RESTRICT b   = b_ptr;
+    const int32_t * GGML_CUDA_RESTRICT pos = pos_ptr;
+    float         * GGML_CUDA_RESTRICT dst = dst_ptr;
+
+    extern __shared__ __align__(16) float sm[]; // t: [D/2] (padded to 4), sA: [NC], then u: [D][LDU] (reused)
+    float * t_s  = sm;
+    float * sa_s = sm + ((D/2 + 3) & ~3);
+    float * u_s  = sa_s + NC;
+
+    const int lane = threadIdx.x;
+    const int wk   = threadIdx.y % NWK;
+    const int ws   = threadIdx.y / NWK;
+    const int tid  = threadIdx.y*WARP_SIZE + lane;
+    const int col0 = blockIdx.x*NC;
+    const int i3   = blockIdx.z;
+    const int half = D/2;
+
+    ggml_cuda_pdl_sync();
+
+    // u per (column, pair): consecutive threads take consecutive pairs of one column (coalesced q and b reads)
+    for (int i = tid; i < NC*half; i += WARP_SIZE*NWK*NS) {
+        const int cl  = i / half;
+        const int j   = i - cl*half;
+        const int col = col0 + cl;
+        float ua = 0.0f;
+        float ub = 0.0f;
+        if (col < ncols) {
+            const int h = col / n_tokens;
+            const int t = col - h*n_tokens;
+            const float * qv = q + h*sq1 + t*sq2 + i3*sq3;
+            const float * bv = b + (h/gqa)*sb1;
+            const float q1 = qv[j];
+            const float q2 = qv[j + half];
+            const float b1 = bv[j];
+            const float b2 = bv[j + half];
+            ua = q1*b1 + q2*b2;
+            ub = q2*b1 - q1*b2;
+        }
+        u_s[j*LDU + cl]          = ua;
+        u_s[(j + half)*LDU + cl] = ub;
+    }
+    for (int j = tid; j < half; j += WARP_SIZE*NWK*NS) {
+        t_s[j] = powf(theta_scale, (2*j)/2.0f); // rope_neox: powf(theta_scale, iw/2.0f), iw = 2j
+    }
+    __syncthreads();
+    if (gate_ptr != nullptr && tid < NC) {
+        float a = 0.0f; // sum_j A_j of column tid (u_j = A_j for j < D/2)
+        for (int j = 0; j < half; ++j) {
+            a += u_s[j*LDU + tid];
+        }
+        sa_s[tid] = a;
+    }
+
+    const int pb = blockIdx.y*KPB + wk*WARP_SIZE*KPT + lane; // key r of this lane: pb + 32 r
+    float pf[KPT];
+#pragma unroll
+    for (int r = 0; r < KPT; ++r) {
+        const int p = pb + r*WARP_SIZE;
+        pf[r] = p < n_kv ? (float) pos[p] : 0.0f;
+    }
+    const int j0 = (ws*half)/NS;
+    const int j1 = ((ws + 1)*half)/NS;
+
+    float acc[KPT][NC];
+#pragma unroll
+    for (int r = 0; r < KPT; ++r) {
+#pragma unroll
+        for (int cl = 0; cl < NC; ++cl) {
+            acc[r][cl] = 0.0f;
+        }
+    }
+    for (int j = j0; j < j1; ++j) {
+        const float tj = t_s[j];
+        float cv[KPT];
+#pragma unroll
+        for (int r = 0; r < KPT; ++r) {
+            cv[r] = cosf(freq_scale*(pf[r]*tj)) - 1.0f;
+        }
+        const float * us = u_s + j*LDU;
+#pragma unroll
+        for (int c4 = 0; c4 < NC; c4 += 4) {
+            const float4 uv = *(const float4 *) (us + c4);
+#pragma unroll
+            for (int r = 0; r < KPT; ++r) {
+                acc[r][c4 + 0] += cv[r]*uv.x;
+                acc[r][c4 + 1] += cv[r]*uv.y;
+                acc[r][c4 + 2] += cv[r]*uv.z;
+                acc[r][c4 + 3] += cv[r]*uv.w;
+            }
+        }
+    }
+    for (int j = j0; j < j1; ++j) {
+        const float tj = t_s[j];
+        float sv[KPT];
+#pragma unroll
+        for (int r = 0; r < KPT; ++r) {
+            sv[r] = sinf(freq_scale*(pf[r]*tj));
+        }
+        const float * us = u_s + (j + half)*LDU;
+#pragma unroll
+        for (int c4 = 0; c4 < NC; c4 += 4) {
+            const float4 uv = *(const float4 *) (us + c4);
+#pragma unroll
+            for (int r = 0; r < KPT; ++r) {
+                acc[r][c4 + 0] += sv[r]*uv.x;
+                acc[r][c4 + 1] += sv[r]*uv.y;
+                acc[r][c4 + 2] += sv[r]*uv.z;
+                acc[r][c4 + 3] += sv[r]*uv.w;
+            }
+        }
+    }
+
+    if constexpr (NS > 1) {
+        __syncthreads(); // u is no longer read: its space holds the partial sums of the warps ws >= 1
+        float * red = u_s;
+        if (ws > 0) {
+#pragma unroll
+            for (int r = 0; r < KPT; ++r) {
+                float * rp = red + (((ws - 1)*NWK + wk)*WARP_SIZE*KPT + r*WARP_SIZE + lane)*LDR;
+#pragma unroll
+                for (int cl = 0; cl < NC; ++cl) {
+                    rp[cl] = acc[r][cl];
+                }
+            }
+        }
+        __syncthreads();
+        if (ws == 0) {
+#pragma unroll
+            for (int s = 1; s < NS; ++s) {
+#pragma unroll
+                for (int r = 0; r < KPT; ++r) {
+                    const float * rp = red + (((s - 1)*NWK + wk)*WARP_SIZE*KPT + r*WARP_SIZE + lane)*LDR;
+#pragma unroll
+                    for (int cl = 0; cl < NC; ++cl) {
+                        acc[r][cl] += rp[cl];
+                    }
+                }
+            }
+        }
+    }
+
+    ggml_cuda_pdl_lc();
+
+    if (ws != 0) {
+        return;
+    }
+#pragma unroll
+    for (int cl = 0; cl < NC; ++cl) {
+        const int col = col0 + cl;
+        if (col < ncols) {
+            const int h = col / n_tokens;
+            const int t = col - h*n_tokens;
+            float * out = dst + t*s1 + h*s2 + i3*s3;
+            const float * gv = gate_ptr != nullptr ? gate_ptr + h/gqa : nullptr;
+#pragma unroll
+            for (int r = 0; r < KPT; ++r) {
+                const int p = pb + r*WARP_SIZE;
+                if (p < n_kv) {
+                    const bool exempt = gv != nullptr && gv[p*sg1] < 0.5f;
+                    out[p] = scale*(exempt ? -sa_s[cl] : acc[r][cl]);
+                }
+            }
+        }
+    }
+}
+
+template <int NC, int KPT, int NWK, int NS>
+static void kq_rope_bias_pos_launch_w(
+        const float * q, const float * b, const int32_t * pos, float * dst,
+        const int D, const int n_kv, const int n_tokens, const int ncols, const int gqa, const int ne3,
+        const int64_t sq1, const int64_t sq2, const int64_t sq3, const int64_t sb1,
+        const int64_t s1, const int64_t s2, const int64_t s3,
+        const float theta_scale, const float freq_scale, const float scale, const float * gate, const int64_t sg1,
+        cudaStream_t stream) {
+    constexpr int KPB = NWK*WARP_SIZE*KPT;
+    const int64_t nbx = (ncols + NC - 1) / NC;
+    const int64_t nby = (n_kv + KPB - 1) / KPB;
+    GGML_ASSERT(nby <= 65535 && ne3 <= 65535);
+    const dim3 grid(nbx, nby, ne3);
+    const dim3 block(WARP_SIZE, NWK*NS, 1);
+    const size_t n_u   = size_t(D)*(NC + 4);
+    const size_t n_red = size_t(NS - 1)*KPB*(NC + 1);
+    const size_t nbytes_shared = (size_t((D/2 + 3) & ~3) + NC + (n_u > n_red ? n_u : n_red))*sizeof(float);
+    GGML_ASSERT(nbytes_shared <= 48*1024);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid, block, nbytes_shared, stream);
+    ggml_cuda_kernel_launch(kq_rope_bias_pos_kernel<NC, KPT, NWK, NS>, launch_params,
+        q, b, pos, dst, D, n_kv, n_tokens, ncols, gqa, sq1, sq2, sq3, sb1, s1, s2, s3, theta_scale, freq_scale, scale,
+        gate, sg1);
+}
+
+template <int NC>
+static void kq_rope_bias_pos_launch(
+        const float * q, const float * b, const int32_t * pos, float * dst,
+        const int D, const int n_kv, const int n_tokens, const int ncols, const int gqa, const int ne3,
+        const int64_t sq1, const int64_t sq2, const int64_t sq3, const int64_t sb1,
+        const int64_t s1, const int64_t s2, const int64_t s3,
+        const float theta_scale, const float freq_scale, const float scale, const int nsm,
+        const float * gate, const int64_t sg1, cudaStream_t stream) {
+    // few keys (fewer blocks of 128 keys than SMs): 1 key per lane, 1 key warp, 8 pair warps;
+    // otherwise 2 keys per lane, 2 key warps x 4 pair warps (128 keys per block)
+    const int64_t nbx = (ncols + NC - 1) / NC;
+    const bool few = nbx*((n_kv + 127) / 128)*ne3 < nsm;
+    if (few) {
+        kq_rope_bias_pos_launch_w<NC, 1, 1, 8>(q, b, pos, dst, D, n_kv, n_tokens, ncols, gqa, ne3,
+            sq1, sq2, sq3, sb1, s1, s2, s3, theta_scale, freq_scale, scale, gate, sg1, stream);
+    } else if constexpr (NC >= 32) {
+        kq_rope_bias_pos_launch_w<NC, 2, 1, 4>(q, b, pos, dst, D, n_kv, n_tokens, ncols, gqa, ne3,
+            sq1, sq2, sq3, sb1, s1, s2, s3, theta_scale, freq_scale, scale, gate, sg1, stream);
+    } else {
+        kq_rope_bias_pos_launch_w<NC, 2, 2, 4>(q, b, pos, dst, D, n_kv, n_tokens, ncols, gqa, ne3,
+            sq1, sq2, sq3, sb1, s1, s2, s3, theta_scale, freq_scale, scale, gate, sg1, stream);
+    }
+}
+
+template <typename c_t, int KPT, int UNROLL>
+static void kq_rope_bias_case_u(
+        const int nwc, const float * q, const float * b, const c_t * c, float * dst,
+        const int D, const int n_kv, const int n_tokens, const int ncols, const int gqa, const int ne3,
+        const int64_t sq1, const int64_t sq2, const int64_t sq3, const int64_t sb1,
+        const int64_t sc1, const int64_t sc3, const int nec3,
+        const int64_t s1, const int64_t s2, const int64_t s3, const float scale, cudaStream_t stream) {
+    switch (nwc) {
+        case 1: kq_rope_bias_launch<c_t, KPT, 1, UNROLL>(q, b, c, dst, D, n_kv, n_tokens, ncols, gqa, ne3, sq1, sq2, sq3, sb1, sc1, sc3, nec3, s1, s2, s3, scale, stream); break;
+        case 2: kq_rope_bias_launch<c_t, KPT, 2, UNROLL>(q, b, c, dst, D, n_kv, n_tokens, ncols, gqa, ne3, sq1, sq2, sq3, sb1, sc1, sc3, nec3, s1, s2, s3, scale, stream); break;
+        case 3: kq_rope_bias_launch<c_t, KPT, 3, UNROLL>(q, b, c, dst, D, n_kv, n_tokens, ncols, gqa, ne3, sq1, sq2, sq3, sb1, sc1, sc3, nec3, s1, s2, s3, scale, stream); break;
+        default: kq_rope_bias_launch<c_t, KPT, 4, UNROLL>(q, b, c, dst, D, n_kv, n_tokens, ncols, gqa, ne3, sq1, sq2, sq3, sb1, sc1, sc3, nec3, s1, s2, s3, scale, stream); break;
+    }
+}
+
+template <typename c_t, int KPT>
+static void kq_rope_bias_case(
+        const int unroll, const int nwc, const float * q, const float * b, const c_t * c, float * dst,
+        const int D, const int n_kv, const int n_tokens, const int ncols, const int gqa, const int ne3,
+        const int64_t sq1, const int64_t sq2, const int64_t sq3, const int64_t sb1,
+        const int64_t sc1, const int64_t sc3, const int nec3,
+        const int64_t s1, const int64_t s2, const int64_t s3, const float scale, cudaStream_t stream) {
+    if (unroll == 8) {
+        kq_rope_bias_case_u<c_t, KPT, 8>(nwc, q, b, c, dst, D, n_kv, n_tokens, ncols, gqa, ne3, sq1, sq2, sq3, sb1, sc1, sc3, nec3, s1, s2, s3, scale, stream);
+    } else {
+        kq_rope_bias_case_u<c_t, KPT, 32>(nwc, q, b, c, dst, D, n_kv, n_tokens, ncols, gqa, ne3, sq1, sq2, sq3, sb1, sc1, sc3, nec3, s1, s2, s3, scale, stream);
+    }
+}
+
+void ggml_cuda_op_kq_rope_bias(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * b = dst->src[1];
+    const ggml_tensor * c = dst->src[2];
+
+    GGML_ASSERT(ggml_cuda_kq_rope_bias_supported(dst));
+
+    if (c->type == GGML_TYPE_I32) {
+        const int D        = q->ne[0];
+        const int n_tokens = q->ne[2];
+        const int ncols    = q->ne[1]*n_tokens;
+        const int nsm      = ggml_cuda_info().devices[ctx.device].nsm;
+        const float scale       = ggml_get_op_params_f32(dst, 0);
+        const float theta_scale = ggml_get_op_params_f32(dst, 1);
+        const float freq_scale  = ggml_get_op_params_f32(dst, 2);
+        const float * q_d = (const float *) q->data;
+        const float * b_d = (const float *) b->data;
+        const int32_t * p_d = (const int32_t *) c->data;
+        float * dst_d = (float *) dst->data;
+        const int64_t sq1 = q->nb[1]/sizeof(float), sq2 = q->nb[2]/sizeof(float), sq3 = q->nb[3]/sizeof(float);
+        const int64_t sb1 = b->nb[1]/sizeof(float);
+        const int64_t s1 = dst->nb[1]/sizeof(float), s2 = dst->nb[2]/sizeof(float), s3 = dst->nb[3]/sizeof(float);
+        const int gqa = q->ne[1] / b->ne[1];
+        const ggml_tensor * gt = dst->src[3];
+        const float * g_d = gt != nullptr ? (const float *) gt->data : nullptr;
+        const int64_t sg1 = gt != nullptr ? gt->nb[1]/sizeof(float) : 0;
+        cudaStream_t stream = ctx.stream();
+        // columns per block: 8 / 16 / 32 (more columns: several blocks along x)
+#define KQRB_POS_ARGS q_d, b_d, p_d, dst_d, D, (int) c->ne[0], n_tokens, ncols, gqa, (int) q->ne[3], \
+            sq1, sq2, sq3, sb1, s1, s2, s3, theta_scale, freq_scale, scale, nsm, g_d, sg1, stream
+        if (ncols <= 8) {
+            kq_rope_bias_pos_launch<8>(KQRB_POS_ARGS);
+        } else if (ncols <= 16 || D > 64) {
+            kq_rope_bias_pos_launch<16>(KQRB_POS_ARGS); // more columns: several column blocks of 16
+        } else {
+            kq_rope_bias_pos_launch<32>(KQRB_POS_ARGS);
+        }
+#undef KQRB_POS_ARGS
+        return;
+    }
+
+    const int D        = q->ne[0];
+    const int n_head   = q->ne[1];
+    const int n_tokens = q->ne[2];
+    const int ne3      = q->ne[3];
+    const int n_kv     = c->ne[0];
+    const int ncols    = n_head*n_tokens;
+    const int gqa      = n_head / b->ne[1];
+    const float scale  = ggml_get_op_params_f32(dst, 0);
+
+    const size_t ts = ggml_type_size(c->type);
+
+    const int64_t sq1 = q->nb[1]/sizeof(float);
+    const int64_t sq2 = q->nb[2]/sizeof(float);
+    const int64_t sq3 = q->nb[3]/sizeof(float);
+    const int64_t sb1 = b->nb[1]/sizeof(float);
+    const int64_t sc1 = c->nb[1]/ts;
+    const int64_t sc3 = c->nb[3]/ts;
+    const int64_t s1  = dst->nb[1]/sizeof(float);
+    const int64_t s2  = dst->nb[2]/sizeof(float);
+    const int64_t s3  = dst->nb[3]/sizeof(float);
+
+    // columns per block: NWC warps x 8 columns
+    const int nwc = ncols <= 8 ? 1 : ncols <= 16 ? 2 : ncols <= 24 ? 3 : 4;
+    const int nwk = nwc >= 4 ? 2 : 8/nwc;
+
+    // 4 keys per lane (one vector load) if the layout allows it and there are still enough blocks for all SMs
+    const bool vec_ok = n_kv % 4 == 0 && sc1 % 4 == 0 && sc3 % 4 == 0 && s1 % 4 == 0 && s2 % 4 == 0 && s3 % 4 == 0 &&
+        (uintptr_t) c->data % (4*ts) == 0 && (uintptr_t) dst->data % 16 == 0;
+    const int64_t nblocks4 = (int64_t) ((ncols + nwc*KQRB_NCW - 1) / (nwc*KQRB_NCW)) * ((n_kv + nwk*WARP_SIZE*4 - 1) / (nwk*WARP_SIZE*4)) * ne3;
+    static const int kpt_env = getenv("GGML_CUDA_KQRB_KPT") ? atoi(getenv("GGML_CUDA_KQRB_KPT")) : 0; // tuning only
+    int kpt = vec_ok && nblocks4 >= ggml_cuda_info().devices[ctx.device].nsm ? 4 : 1;
+    if (kpt_env == 1 || (kpt_env == 4 && vec_ok)) {
+        kpt = kpt_env;
+    }
+    // loads in flight per lane; the unroll factor does not change the order of the accumulation (tuning only: env)
+    static const int unroll = getenv("GGML_CUDA_KQRB_UNROLL") && atoi(getenv("GGML_CUDA_KQRB_UNROLL")) == 8 ? 8 : 32;
+
+    const float * q_d = (const float *) q->data;
+    const float * b_d = (const float *) b->data;
+    float * dst_d = (float *) dst->data;
+    cudaStream_t stream = ctx.stream();
+
+    if (c->type == GGML_TYPE_F16) {
+        const half * c_d = (const half *) c->data;
+        if (kpt == 4) {
+            kq_rope_bias_case<half, 4>(unroll, nwc, q_d, b_d, c_d, dst_d, D, n_kv, n_tokens, ncols, gqa, ne3, sq1, sq2, sq3, sb1, sc1, sc3, c->ne[3], s1, s2, s3, scale, stream);
+        } else {
+            kq_rope_bias_case<half, 1>(unroll, nwc, q_d, b_d, c_d, dst_d, D, n_kv, n_tokens, ncols, gqa, ne3, sq1, sq2, sq3, sb1, sc1, sc3, c->ne[3], s1, s2, s3, scale, stream);
+        }
+    } else {
+        const float * c_d = (const float *) c->data;
+        if (kpt == 4) {
+            kq_rope_bias_case<float, 4>(unroll, nwc, q_d, b_d, c_d, dst_d, D, n_kv, n_tokens, ncols, gqa, ne3, sq1, sq2, sq3, sb1, sc1, sc3, c->ne[3], s1, s2, s3, scale, stream);
+        } else {
+            kq_rope_bias_case<float, 1>(unroll, nwc, q_d, b_d, c_d, dst_d, D, n_kv, n_tokens, ncols, gqa, ne3, sq1, sq2, sq3, sb1, sc1, sc3, c->ne[3], s1, s2, s3, scale, stream);
+        }
+    }
+}
+
+bool ggml_cuda_kq_rope_bias_supported(const ggml_tensor * dst) {
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * b = dst->src[1];
+    const ggml_tensor * c = dst->src[2];
+
+    if (dst->type != GGML_TYPE_F32 || q->type != GGML_TYPE_F32 || b->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (c->type == GGML_TYPE_I32) {
+        // position form: u of 32 or 64 columns plus D/2 powers in shared memory (<= 37 KB)
+        return q->ne[0] % 2 == 0 && q->ne[0] <= 256 && q->nb[0] == sizeof(float) && b->nb[0] == sizeof(float) &&
+            (q->nb[1] | q->nb[2] | q->nb[3] | b->nb[1]) % sizeof(float) == 0 && ggml_is_contiguous(c) &&
+            ggml_is_vector(c) && ggml_is_contiguous(dst) && b->ne[2] == 1 && b->ne[3] == 1 &&
+            (dst->src[3] == nullptr || (dst->src[3]->type == GGML_TYPE_F32 && dst->src[3]->nb[0] == sizeof(float) &&
+             dst->src[3]->ne[0] == b->ne[1] && dst->src[3]->ne[1] == c->ne[0]));
+    }
+    if (c->type != GGML_TYPE_F32 && c->type != GGML_TYPE_F16) {
+        return false;
+    }
+    // u of a block lives in shared memory: D*(32 + 4) floats, at most 36 KB for D = 256
+    if (q->ne[0] % 2 != 0 || q->ne[0] > 256) {
+        return false;
+    }
+    if (q->nb[0] != sizeof(float) || b->nb[0] != sizeof(float) || c->nb[0] != ggml_type_size(c->type)) {
+        return false;
+    }
+    if ((q->nb[1] | q->nb[2] | q->nb[3] | b->nb[1]) % sizeof(float) != 0 || (c->nb[1] | c->nb[3]) % ggml_type_size(c->type) != 0) {
+        return false;
+    }
+    return ggml_is_contiguous(dst) && b->ne[2] == 1 && b->ne[3] == 1 && c->ne[2] == 1;
+}
+
+// ------------------------------------------------------------------------------------------------ SG2 sink gate
+// mode 0: one block per row (h, t); the products k*mu go to shared memory and are summed with reduce_row_f32 under the
+// block size rule of sum_rows_f32_cuda, so dot equals SG1's mul + sum_rows bit for bit; then (dot - half) > 0 as
+// SG1's sub + step. force: -1 rule, 1 all centred, 0 all exempt (SG1: scale_bias(dot, 0, force)).
+static __global__ void kv_mu_gate_kernel(const char * k, const float * mu, const float * half, float * g,
+        const int D, const int H, const int64_t nbk1, const int64_t nbk2, const int force) {
+    extern __shared__ float prod_s[];
+    ggml_cuda_pdl_sync(); // k may be the output of the previous kernel (PDL)
+    const int r = blockIdx.x;
+    const int h = r % H;
+    const int t = r / H;
+    const float * kr = (const float *) (k + h*nbk1 + t*nbk2);
+    const float * mr = mu + h*D;
+    for (int i = threadIdx.x; i < D; i += blockDim.x) {
+        prod_s[i] = kr[i]*mr[i];
+    }
+    __syncthreads();
+    const float dot = reduce_row_f32(prod_s, D);
+    if (threadIdx.x == 0) {
+        g[h + t*H] = force < 0 ? (float) ((dot - half[h]) > 0.0f) : 0.0f*dot + (float) force;
+    }
+}
+
+// mode 1: k_out = k - mu*g (SG1: repeat, mul, sub)
+static __global__ void kv_mu_apply_kernel(const char * k, const float * mu, const float * g, float * out,
+        const int D, const int H, const int T, const int64_t nbk1, const int64_t nbk2) {
+    ggml_cuda_pdl_sync();
+    const int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= (int64_t) D*H*T) {
+        return;
+    }
+    const int d = i % D;
+    const int h = (i / D) % H;
+    const int t = i / ((int64_t) D*H);
+    const float kv = ((const float *) (k + h*nbk1 + t*nbk2))[d];
+    out[i] = kv - mu[h*D + d]*g[h + t*H];
+}
+
+void ggml_cuda_op_kv_mu_gate(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * k  = dst->src[0];
+    const ggml_tensor * mu = dst->src[1];
+    const ggml_tensor * x  = dst->src[2];
+    const int mode = ggml_get_op_params_i32(dst, 0);
+    const int D = k->ne[0], H = k->ne[1], T = k->ne[2];
+    cudaStream_t stream = ctx.stream();
+    if (mode == 0) {
+        const int force = ggml_get_op_params_i32(dst, 1);
+        const int nrows = H*T;
+        const int nsm   = ggml_cuda_info().devices[ctx.device].nsm;
+        // the block size rule of sum_rows_f32_cuda for contiguous rows of D products
+        const int nthreads = (nrows / nsm) < 2 ? 512 : (D < 1024 ? 32 : 128);
+        const ggml_cuda_kernel_launch_params lp = ggml_cuda_kernel_launch_params(dim3(nrows), dim3(nthreads), D*sizeof(float), stream);
+        ggml_cuda_kernel_launch(kv_mu_gate_kernel, lp, (const char *) k->data, (const float *) mu->data, (const float *) x->data,
+            (float *) dst->data, D, H, (int64_t) k->nb[1], (int64_t) k->nb[2], force);
+    } else {
+        const int64_t n = (int64_t) D*H*T;
+        const int nb = (n + 255)/256;
+        const ggml_cuda_kernel_launch_params lp = ggml_cuda_kernel_launch_params(dim3(nb), dim3(256), 0, stream);
+        ggml_cuda_kernel_launch(kv_mu_apply_kernel, lp, (const char *) k->data, (const float *) mu->data, (const float *) x->data,
+            (float *) dst->data, D, H, T, (int64_t) k->nb[1], (int64_t) k->nb[2]);
+    }
+}
+
+bool ggml_cuda_kv_mu_gate_supported(const ggml_tensor * dst) {
+    const ggml_tensor * k = dst->src[0];
+    return dst->type == GGML_TYPE_F32 && k->type == GGML_TYPE_F32 && k->nb[0] == sizeof(float) && k->ne[3] == 1 &&
+        k->ne[0] <= 8192 && (k->nb[1] | k->nb[2]) % sizeof(float) == 0 && ggml_is_contiguous(dst);
+}
