+    std::string vars() override {
+        return VARS_TO_STR10(type_c, hs, nh, nh_kv, nt, kv, ns, q_perm, scale, gated);
+    }
+
+    uint64_t op_flops(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return 2 * kv * hs * nh * nt * ns[0];
+    }
+
+    // positions of the position form: unordered, up to pos_max - 1 (cells of a cache are not sorted)
+    int64_t pos_max = 32768;
+    bool gated = false; // SG1: position form with a gate tensor
+
+    void initialize_tensors(ggml_context * ctx) override {
+        std::mt19937 rng(1234);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(ggml_get_name(t), "gate") == 0) { // SG1: random 0 / 1 flags, about a third exempt
+                std::vector<float> g(ggml_nelements(t));
+                std::uniform_int_distribution<int> dist(0, 2);
+                for (auto & x : g) {
+                    x = dist(rng) == 0 ? 0.0f : 1.0f;
+                }
+                ggml_backend_tensor_set(t, g.data(), 0, g.size()*sizeof(float));
+            } else if (t->type == GGML_TYPE_I32) {
+                std::vector<int32_t> p(ggml_nelements(t));
+                std::uniform_int_distribution<int32_t> dist(0, (int32_t) pos_max - 1);
+                for (auto & x : p) {
+                    x = dist(rng);
+                }
+                ggml_backend_tensor_set(t, p.data(), 0, p.size()*sizeof(int32_t));
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+
+    double max_nmse_err() override {
+        // position form: CUDA evaluates cosf / sinf of arguments up to ~3e4 with the fast intrinsics, as its rope
+        return type_c == GGML_TYPE_I32 ? 1e-5 : 1e-7;
+    }
+
+    test_kq_rope_bias(ggml_type type_c = GGML_TYPE_F16, int64_t hs = 128, int64_t nh = 28, int64_t nh_kv = 4,
+            int64_t nt = 1, int64_t kv = 512, std::array<int64_t, 2> ns = {1, 1}, bool q_perm = false, float scale = 1.0f)
+        : type_c(type_c), hs(hs), nh(nh), nh_kv(nh_kv), nt(nt), kv(kv), ns(ns), q_perm(q_perm), scale(scale) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * q;
+        if (q_perm) {
+            q = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, hs, nt, nh, ns[0]);
+            ggml_set_name(q, "q");
+            q = ggml_permute(ctx, q, 0, 2, 1, 3); // [hs, nh, nt, ns]
+        } else {
+            q = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, hs, nh, nt, ns[0]);
+            ggml_set_name(q, "q");
+        }
+
+        ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, hs, nh_kv);
+        ggml_set_name(b, "b");
+
+        if (type_c == GGML_TYPE_I32) { // position form
+            ggml_tensor * pos = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, kv);
+            ggml_set_name(pos, "pos");
+            ggml_tensor * out;
+            if (gated) {
+                ggml_tensor * gate = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, nh_kv, kv);
+                ggml_set_name(gate, "gate");
+                out = ggml_kq_rope_bias_pos_gated(ctx, q, b, pos, gate, 1000000.0f, 1.0f, scale);
+            } else {
+                out = ggml_kq_rope_bias_pos(ctx, q, b, pos, 1000000.0f, 1.0f, scale);
+            }
+            ggml_set_name(out, "out");
+            return out;
+        }
+        ggml_tensor * c = ggml_new_tensor_4d(ctx, type_c, kv, hs, 1, ns[1]);
+        ggml_set_name(c, "c");
+
+        ggml_tensor * out = ggml_kq_rope_bias(ctx, q, b, c, scale);
+        ggml_set_name(out, "out");
+
+        return out;
+    }
+};
