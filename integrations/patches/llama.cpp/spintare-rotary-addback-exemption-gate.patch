new file mode 100644
--- /dev/null
+++ b/src/models/kv-mu.h
@@ -0,0 +1,446 @@
+#pragma once
+
+// KV de-offset with a calibrated shared key component (experimental, env LLAMA_KV_DEBIAS_MU=<file>).
+// mu[l][h] is the mean pre-RoPE key of layer l, kv head h (after any k bias and k norm), estimated offline on a
+// calibration text. The model graph subtracts mu from K before RoPE (so the cached, quantized K holds only the
+// content part) and adds its score contribution q . R(p) mu back:
+//   decode graphs (<= 2 tokens; models that pass the llama_model to init): as a per-head KQ bias inside the flash
+//     attention vec kernel (the kq_bias path of the k-bias patch in qwen2.cpp), K stays quantized:
+//       sum_j A_j (cos(p theta_j) - 1) + B_j sin(p theta_j),
+//       A_j = q_j mu_j + q_{j+h} mu_{j+h}, B_j = q_{j+h} mu_j - q_j mu_{j+h}, h = n_embd_head/2;
+//     the dropped term sum_j A_j is the same for every key of a query (softmax invariant; no attention sinks).
+//     LLAMA_KV_DEBIAS_MU_PATH: "kqbias" (default: u = m q and c'^T u, two ops per layer), "fused" (one
+//     GGML_OP_KQ_ROPE_BIAS per layer, c' in F16 scaled by 2^8) or "kadd" (the path below, also for decode).
+//   other graphs (prefill), and models that do not pass the llama_model: K is rebuilt in F16 as
+//     dequant(K) + H R(p) mu before attention ("kadd" path, consumed in llm_graph_context::build_attn).
+// With the llama_model, mu, the pair matrices m and the unit vectors are persistent weight-like tensors (no per-step
+// upload); without it (and while the model weights are not allocated, e.g. memory fitting) mu is a graph input.
+// Flash attention only, single KV stream only; the KQ bias paths need NEOX RoPE over the whole head.
+//
+// File layout (little endian): char magic[4] = "KVMU", int32 version = 1, int32 n_layer, int32 n_head_kv,
+// int32 n_embd_head, then float32 mu[n_layer][n_head_kv][n_embd_head].
+
+#include "llama-graph.h"
+#include "llama-impl.h"
+#include "llama-model.h"
+#include "llama-kv-cache.h"
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace kv_mu {
+
+struct mu_file {
+    int32_t            n_layer     = 0;
+    int32_t            n_head_kv   = 0;
+    int32_t            n_embd_head = 0;
+    std::vector<float> data; // [n_layer][n_head_kv][n_embd_head]
+};
+
+// path from LLAMA_KV_DEBIAS_MU, or nullptr when the feature is off
+inline const char * path() {
+    const char * p = getenv("LLAMA_KV_DEBIAS_MU");
+    return p && p[0] ? p : nullptr;
+}
+
+// add-back path of decode graphs
+enum dec_path { DEC_KADD, DEC_KQBIAS, DEC_FUSED, DEC_KQPOS };
+
+inline dec_path decode_path() {
+    static const dec_path res = [] {
+        const char * e = getenv("LLAMA_KV_DEBIAS_MU_PATH");
+        if (e == nullptr || e[0] == 0 || strcmp(e, "kqbias") == 0) {
+            return DEC_KQBIAS;
+        }
+        if (strcmp(e, "fused") == 0) {
+            return DEC_FUSED;
+        }
+        if (strcmp(e, "kqpos") == 0) {
+            return DEC_KQPOS;
+        }
+        GGML_ASSERT(strcmp(e, "kadd") == 0 && "LLAMA_KV_DEBIAS_MU_PATH: kqbias, fused, kqpos or kadd");
+        return DEC_KADD;
+    }();
+    return res;
+}
+
+// SG1 sink gate (LLAMA_KV_MU_GATE): 0 off; 1 gate (exempt a row when 1 - k.mu/|mu|^2 >= 0.5, i.e. when centring
+// would lengthen it); "centre" / "exempt": every row centred / exempt through the gate code (test modes)
+enum gate_mode { GATE_OFF, GATE_ON, GATE_CENTRE, GATE_EXEMPT };
+
+inline gate_mode gate_setting() {
+    static const gate_mode res = [] {
+        const char * e = getenv("LLAMA_KV_MU_GATE");
+        if (e == nullptr || e[0] == 0 || strcmp(e, "0") == 0) {
+            return GATE_OFF;
+        }
+        if (strcmp(e, "centre") == 0) {
+            return GATE_CENTRE;
+        }
+        if (strcmp(e, "exempt") == 0) {
+            return GATE_EXEMPT;
+        }
+        GGML_ASSERT(strcmp(e, "1") == 0 && "LLAMA_KV_MU_GATE: 0, 1, centre or exempt");
+        return GATE_ON;
+    }();
+    return res;
+}
+
+// scale of the F16 c' table of the fused path: 2^8 keeps its small entries out of the F16 subnormal range
+constexpr float fused_c_scale = 256.0f;
+
+// loaded once per process; aborts on a malformed file
+inline const mu_file & load(const char * fname) {
+    static std::mutex  mtx;
+    static std::string loaded_name;
+    static mu_file     mf;
+
+    std::lock_guard<std::mutex> lock(mtx);
+    if (loaded_name == fname) {
+        return mf;
+    }
+    FILE * f = fopen(fname, "rb");
+    GGML_ASSERT(f != nullptr && "LLAMA_KV_DEBIAS_MU: cannot open file");
+    char    magic[4];
+    int32_t hdr[4];
+    GGML_ASSERT(fread(magic, 1, 4, f) == 4 && memcmp(magic, "KVMU", 4) == 0 && "LLAMA_KV_DEBIAS_MU: bad magic");
+    GGML_ASSERT(fread(hdr, sizeof(int32_t), 4, f) == 4 && hdr[0] == 1 && "LLAMA_KV_DEBIAS_MU: bad version");
+    mu_file r;
+    r.n_layer     = hdr[1];
+    r.n_head_kv   = hdr[2];
+    r.n_embd_head = hdr[3];
+    const size_t n = size_t(r.n_layer)*r.n_head_kv*r.n_embd_head;
+    r.data.resize(n);
+    GGML_ASSERT(fread(r.data.data(), sizeof(float), n, f) == n && "LLAMA_KV_DEBIAS_MU: short file");
+    fclose(f);
+    LLAMA_LOG_INFO("%s: KV de-offset with calibrated mu from %s: %d layers, %d kv heads, head dim %d\n",
+            __func__, fname, r.n_layer, r.n_head_kv, r.n_embd_head);
+    mf          = std::move(r);
+    loaded_name = fname;
+    return mf;
+}
+
+// graph input holding all of mu as one F32 tensor [n_embd_head, n_head_kv, n_layer]
+class input_mu : public llm_graph_input_i {
+public:
+    explicit input_mu(const mu_file & mf) : mf(mf) {}
+
+    void set_input(const llama_ubatch * ubatch) override {
+        GGML_UNUSED(ubatch);
+        if (mu && mu->buffer) {
+            ggml_backend_tensor_set(mu, mf.data.data(), 0, ggml_nbytes(mu));
+        }
+    }
+
+    bool can_reuse(const llm_graph_params & params) override {
+        GGML_UNUSED(params);
+        return true;
+    }
+
+    ggml_tensor *   mu = nullptr;
+    const mu_file & mf;
+};
+
+// persistent copies of mu and of the derived tensors, allocated like weights (one buffer per layer buffer type)
+struct plan {
+    std::vector<ggml_tensor *> mu;              // per layer: F32 [n_embd_head, n_head_kv]
+    std::vector<ggml_tensor *> m;               // per layer: F32 [n_embd_head, n_embd_head, n_head_kv], u = m q
+    std::vector<ggml_tensor *> half_mu2;          // per layer: F32 [1, n_head_kv] = |mu|^2 / 2 (SG1 gate)
+    ggml_tensor *              unit     = nullptr; // F32 [n_embd_head] = [1..1, 0..0]
+    ggml_tensor *              unit_c16 = nullptr; // F32 [n_embd_head] = [2^8..2^8, 0..0] (fused path)
+
+    std::vector<ggml_backend_buffer_type_t> bufts; // layer buffer types the plan was built for
+    std::vector<ggml_context *>             ctxs;
+    std::vector<ggml_backend_buffer_t>      bufs;
+};
+
+inline void plan_free(plan & pl) {
+    for (ggml_backend_buffer_t buf : pl.bufs) {
+        ggml_backend_buffer_free(buf);
+    }
+    for (ggml_context * ctx : pl.ctxs) {
+        ggml_free(ctx);
+    }
+    pl = plan();
+}
+
+inline void plan_build(plan & pl, const llama_model & model, const mu_file & mf) {
+    const int64_t n_layer = mf.n_layer;
+    const int64_t n_head_kv = mf.n_head_kv;
+    const int64_t D    = mf.n_embd_head;
+    const int64_t half = D/2;
+
+    std::map<ggml_backend_buffer_type_t, ggml_context *> ctx_map;
+    const auto ctx_for_buft = [&](ggml_backend_buffer_type_t buft) -> ggml_context * {
+        auto it = ctx_map.find(buft);
+        if (it != ctx_map.end()) {
+            return it->second;
+        }
+        ggml_init_params params = {
+            /*.mem_size   =*/ (3*size_t(n_layer) + 2)*ggml_tensor_overhead(),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        ggml_context * ctx = ggml_init(params);
+        GGML_ASSERT(ctx != nullptr);
+        ctx_map[buft] = ctx;
+        pl.ctxs.push_back(ctx);
+        return ctx;
+    };
+
+    pl.mu.assign(n_layer, nullptr);
+    pl.m.assign(n_layer, nullptr);
+    pl.half_mu2.assign(n_layer, nullptr);
+    pl.bufts.assign(n_layer, nullptr);
+    for (int64_t il = 0; il < n_layer; ++il) {
+        pl.bufts[il] = model.select_buft(il);
+        ggml_context * ctx = ctx_for_buft(pl.bufts[il]);
+        pl.mu[il] = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, D, n_head_kv);
+        pl.m[il]  = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, D, D, n_head_kv);
+        ggml_format_name(pl.mu[il], "kv_mu-%d", int(il));
+        ggml_format_name(pl.m[il],  "kv_mu_m-%d", int(il));
+        pl.half_mu2[il] = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1, n_head_kv);
+        ggml_format_name(pl.half_mu2[il], "kv_mu_half2-%d", int(il));
+    }
+    // the per-graph c' table is built next to the last layer: with partial offload the last layers are offloaded
+    {
+        ggml_context * ctx = ctx_for_buft(pl.bufts[n_layer - 1]);
+        pl.unit     = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, D);
+        pl.unit_c16 = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, D);
+        ggml_set_name(pl.unit,     "kv_mu_unit");
+        ggml_set_name(pl.unit_c16, "kv_mu_unit_c16");
+    }
+
+    for (const auto & it : ctx_map) {
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(it.second, it.first);
+        GGML_ASSERT(buf != nullptr && "LLAMA_KV_DEBIAS_MU: failed to allocate the plan buffer");
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        pl.bufs.push_back(buf);
+    }
+
+    std::vector<float> m(D*D*n_head_kv);
+    for (int64_t il = 0; il < n_layer; ++il) {
+        const float * mul = mf.data.data() + il*n_head_kv*D;
+        ggml_backend_tensor_set(pl.mu[il], mul, 0, ggml_nbytes(pl.mu[il]));
+
+        // u = m q (ggml_mul_mat: u_i = sum_k m[k + i*D] q_k): u_j = A_j, u_{j+h} = B_j
+        std::fill(m.begin(), m.end(), 0.0f);
+        for (int64_t h = 0; h < n_head_kv; ++h) {
+            float * mh = m.data() + h*D*D;
+            for (int64_t j = 0; j < half; ++j) {
+                const float b1 = mul[h*D + j];
+                const float b2 = mul[h*D + j + half];
+                mh[j*D + j]                 =  b1; // A_j = q_j b_j + q_{j+h} b_{j+h}
+                mh[j*D + j + half]          =  b2;
+                mh[(j + half)*D + j]        = -b2; // B_j = q_{j+h} b_j - q_j b_{j+h}
+                mh[(j + half)*D + j + half] =  b1;
+            }
+        }
+        ggml_backend_tensor_set(pl.m[il], m.data(), 0, ggml_nbytes(pl.m[il]));
+
+        std::vector<float> h2(n_head_kv);
+        for (int64_t h = 0; h < n_head_kv; ++h) {
+            double s = 0.0;
+            for (int64_t k = 0; k < D; ++k) {
+                s += double(mul[h*D + k])*double(mul[h*D + k]);
+            }
+            h2[h] = float(0.5*s);
+        }
+        ggml_backend_tensor_set(pl.half_mu2[il], h2.data(), 0, ggml_nbytes(pl.half_mu2[il]));
+    }
+
+    std::vector<float> e(D, 0.0f);
+    std::fill(e.begin(), e.begin() + half, 1.0f);
+    ggml_backend_tensor_set(pl.unit, e.data(), 0, ggml_nbytes(pl.unit));
+    std::fill(e.begin(), e.begin() + half, fused_c_scale);
+    ggml_backend_tensor_set(pl.unit_c16, e.data(), 0, ggml_nbytes(pl.unit_c16));
+}
+
+// note: cached per (model address, mu file name) for the lifetime of the process (experimental limitation, as the
+//       k-bias plan in qwen2.cpp); rebuilt when a layer's buffer type changes
+inline const plan & get_plan(const llama_model & model, const mu_file & mf, const char * fname) {
+    static std::mutex mtx;
+    static std::map<std::pair<const llama_model *, std::string>, plan> plans;
+
+    std::lock_guard<std::mutex> lock(mtx);
+    plan & pl = plans[{&model, std::string(fname)}];
+    bool ok = int64_t(pl.mu.size()) == mf.n_layer;
+    for (size_t il = 0; ok && il < pl.bufts.size(); ++il) {
+        ok = pl.bufts[il] == model.select_buft(il);
+    }
+    if (!ok) {
+        plan_free(pl);
+        plan_build(pl, model, mf);
+    }
+    return pl;
+}
+
+// per-graph state: build once before the layer loop, then call sub() and add_back() per layer
+struct state {
+    const plan *  pl     = nullptr; // persistent tensors, or nullptr (mu is then the graph input below)
+    ggml_tensor * mu     = nullptr; // F32 [n_embd_head, n_head_kv, n_layer] graph input (only without pl)
+    ggml_tensor * kv_pos = nullptr; // I32 [n_kv]
+    ggml_tensor * c      = nullptr; // KQ bias paths: c' = R(p) e - e, F32 [n_embd_head, n_kv] (kqbias) or
+                                    //                2^8 c' as F16 [n_kv, n_embd_head] (fused)
+    int64_t       n_kv   = 0;
+    dec_path      path   = DEC_KADD; // add-back path of this graph
+    gate_mode     gate   = GATE_OFF; // SG1
+    const llm_graph_input_attn_kv * inp = nullptr; // for the K indices and the flag tensor (SG1)
+    mutable ggml_tensor * gate_cur = nullptr;     // F32 [1, n_head_kv, n_tokens] of the layer last passed to sub()
+};
+
+// returns false (and leaves st empty) when the feature is off; model == nullptr keeps the graph-input mu and the kadd
+// path for every graph
+inline bool init(state & st, llm_graph_context & g, llm_graph_input_attn_kv * inp_attn,
+        int64_t n_layer, int64_t n_head_kv, int64_t n_embd_head, const llama_model * model = nullptr) {
+    const char * fname = path();
+    if (fname == nullptr || g.cparams.training) {
+        return false;
+    }
+    GGML_ASSERT(g.cparams.flash_attn && "LLAMA_KV_DEBIAS_MU requires flash attention (-fa on)");
+    const mu_file & mf = load(fname);
+    GGML_ASSERT(mf.n_layer == n_layer && mf.n_head_kv == n_head_kv && mf.n_embd_head == n_embd_head &&
+            "LLAMA_KV_DEBIAS_MU: shape does not match the model");
+
+    const ggml_tensor * kq_mask = inp_attn->get_kq_mask();
+    GGML_ASSERT(kq_mask->ne[3] == 1 && "LLAMA_KV_DEBIAS_MU requires a single KV stream");
+    st.n_kv = kq_mask->ne[0];
+
+    st.kv_pos = ggml_new_tensor_1d(g.ctx0, GGML_TYPE_I32, st.n_kv);
+    ggml_set_input(st.kv_pos);
+    inp_attn->self_kv_pos = st.kv_pos;
+
+    // persistent tensors need allocated weights (no plan while the model is only measured, e.g. memory fitting)
+    const bool weights_allocated = model != nullptr && !model->layers.empty() && model->layers[0].wo != nullptr &&
+            model->layers[0].wo->buffer != nullptr;
+    if (!weights_allocated) {
+        auto inp = std::make_unique<input_mu>(mf);
+        inp->mu = ggml_new_tensor_3d(g.ctx0, GGML_TYPE_F32, n_embd_head, n_head_kv, n_layer);
+        ggml_set_input(inp->mu);
+        st.mu = inp->mu;
+        g.res->add_input(std::move(inp));
+        return true;
+    }
+    st.pl = &get_plan(*model, mf, fname);
+
+    const bool kq_bias_ok = g.n_tokens <= 2 && g.rope_type == LLAMA_ROPE_TYPE_NEOX && g.n_rot == n_embd_head;
+    st.path = kq_bias_ok ? decode_path() : DEC_KADD;
+    if (st.path == DEC_KQPOS && (g.ext_factor != 0.0f || g.attn_factor != 1.0f)) {
+        st.path = DEC_KQBIAS; // the position form evaluates plain NEOX rope only (no YaRN)
+    }
+    st.gate = gate_setting();
+    st.inp  = inp_attn;
+    if (st.gate != GATE_OFF) {
+        GGML_ASSERT((st.path == DEC_KQPOS || st.path == DEC_KADD) &&
+                "LLAMA_KV_MU_GATE: decode graphs need the kqpos path (LLAMA_KV_DEBIAS_MU_PATH=kqpos, plain NEOX rope, no YaRN); prefill uses kadd");
+    }
+    if (st.path == DEC_KQPOS) {
+        return true; // c' is evaluated inside the per-layer op from kv_pos (no table)
+    }
+    if (st.path != DEC_KADD) {
+        ggml_tensor * unit = st.path == DEC_FUSED ? st.pl->unit_c16 : st.pl->unit;
+        ggml_tensor * e  = ggml_repeat_4d(g.ctx0, unit, n_embd_head, 1, st.n_kv, 1);
+        ggml_tensor * cs = ggml_rope_ext(g.ctx0, e, st.kv_pos, nullptr, g.n_rot, g.rope_type, g.n_ctx_orig,
+                g.freq_base, g.freq_scale, g.ext_factor, g.attn_factor, g.beta_fast, g.beta_slow);
+        st.c = ggml_reshape_2d(g.ctx0, ggml_sub(g.ctx0, cs, e), n_embd_head, st.n_kv);
+        if (st.path == DEC_FUSED) {
+            // [n_kv, n_embd_head] F16, keys contiguous (the transposed F16 copy has a tiled fast path on CUDA)
+            st.c = ggml_cont(g.ctx0, ggml_transpose(g.ctx0, ggml_cast(g.ctx0, st.c, GGML_TYPE_F16)));
+        }
+        g.cb(st.c, "kv_mu_c", -1);
+    }
+    return true;
+}
+
+inline ggml_tensor * layer_mu(const state & st, ggml_context * ctx, int64_t il) {
+    if (st.pl) {
+        return st.pl->mu[il];
+    }
+    return ggml_view_3d(ctx, st.mu, st.mu->ne[0], st.mu->ne[1], 1, st.mu->nb[1], st.mu->nb[2], il*st.mu->nb[2]);
+}
+
+// K [n_embd_head, n_head_kv, n_tokens] before RoPE -> K - mu_l
+inline ggml_tensor * sub(const state & st, ggml_context * ctx, ggml_tensor * k, int64_t il) {
+    if (st.gate == GATE_OFF || st.pl == nullptr) {
+        return ggml_sub(ctx, k, layer_mu(st, ctx, il));
+    }
+    // SG1: g = 1 (centre) when k.mu > |mu|^2 / 2, i.e. z = 1 - k.mu/|mu|^2 < 0.5; else 0 (exempt, kept uncentred)
+    ggml_tensor * mu  = st.pl->mu[il];                                  // [D, n_head_kv]
+    // SG2: two fused kernels (gate, apply) instead of mul, sum_rows, sub, step, repeat, mul, sub
+    const int force = st.gate == GATE_ON ? -1 : (st.gate == GATE_CENTRE ? 1 : 0);
+    ggml_tensor * gt = ggml_kv_mu_gate(ctx, k, mu, st.pl->half_mu2[il], force); // [1, n_head_kv, n_tokens]
+    st.gate_cur = gt;
+    return ggml_kv_mu_apply(ctx, k, mu, gt);
+}
+
+// SG1: the flags of all n_kv cells of layer il after this batch's flags are written (the view depends on the
+// set_rows node, so the write is ordered before every reader); F32 [n_head_kv, n_kv]
+inline ggml_tensor * gate_view(const state & st, ggml_context * ctx, int64_t il) {
+    GGML_ASSERT(st.gate_cur != nullptr && st.inp != nullptr);
+    ggml_tensor * kf = st.inp->mctx->get_kflag(il);
+    GGML_ASSERT(kf != nullptr && "LLAMA_KV_MU_GATE: the KV cache has no flag tensor");
+    const int64_t H = st.gate_cur->ne[1];
+    const int64_t T = st.gate_cur->ne[2];
+    ggml_tensor * all = ggml_set_rows(ctx, kf, ggml_reshape_2d(ctx, st.gate_cur, H, T), st.inp->get_k_idxs());
+    st.gate_cur = nullptr;
+    return ggml_view_2d(ctx, all, H, st.n_kv, all->nb[1], 0);
+}
+
+// R(p) mu_l for every KV cell, with the same RoPE parameters as K; consumed by build_attn as kv_debias_k_add
+inline ggml_tensor * rope_mu(const state & st, ggml_context * ctx, int64_t il, int n_rot, int rope_type,
+        int n_ctx_orig, float freq_base, float freq_scale, float ext_factor, float attn_factor,
+        float beta_fast, float beta_slow) {
+    ggml_tensor * m = layer_mu(st, ctx, il);
+    m = ggml_repeat_4d(ctx, m, m->ne[0], m->ne[1], st.n_kv, 1);
+    return ggml_rope_ext(ctx, m, st.kv_pos, nullptr, n_rot, rope_type, n_ctx_orig, freq_base, freq_scale,
+            ext_factor, attn_factor, beta_fast, beta_slow);
+}
+
+// sets the add-back of layer il for the next build_attn call: q is the post-RoPE query [n_embd_head, n_head, n_tokens]
+// before any Hadamard rotation (H is orthonormal, so the score term is unchanged)
+inline void add_back(const state & st, llm_graph_context & g, ggml_tensor * q, int64_t il) {
+    ggml_context * ctx = g.ctx0;
+    if (st.path == DEC_KADD) {
+        g.kv_debias_k_add = rope_mu(st, ctx, il, g.n_rot, g.rope_type, g.n_ctx_orig, g.freq_base, g.freq_scale,
+                g.ext_factor, g.attn_factor, g.beta_fast, g.beta_slow);
+        if (st.gate != GATE_OFF && st.pl != nullptr) {                  // SG1: k_add = g * R(p) mu
+            ggml_tensor * gv = gate_view(st, ctx, il);                  // [n_head_kv, n_kv]
+            g.kv_debias_k_add = ggml_mul(ctx, g.kv_debias_k_add, ggml_reshape_3d(ctx, gv, 1, gv->ne[0], gv->ne[1]));
+        }
+        g.cb(g.kv_debias_k_add, "kv_mu_rb", il);
+        return;
+    }
+    const int64_t D        = q->ne[0];
+    const int64_t n_head   = q->ne[1];
+    const int64_t n_tokens = q->ne[2];
+    ggml_tensor * kqb;
+    if (st.path == DEC_KQPOS) {
+        kqb = st.gate != GATE_OFF
+            ? ggml_kq_rope_bias_pos_gated(ctx, q, st.pl->mu[il], st.kv_pos, gate_view(st, ctx, il), g.freq_base,
+                    g.freq_scale, 1.0f)
+            : ggml_kq_rope_bias_pos(ctx, q, st.pl->mu[il], st.kv_pos, g.freq_base, g.freq_scale, 1.0f);  // [n_kv, n_tokens, n_head]
+    } else if (st.path == DEC_FUSED) {
+        kqb = ggml_kq_rope_bias(ctx, q, st.pl->mu[il], st.c, 1.0f/fused_c_scale);              // [n_kv, n_tokens, n_head]
+    } else {
+        ggml_tensor * q_t = ggml_permute(ctx, q, 0, 2, 1, 3);                                    // [D, n_tokens, n_head]
+        ggml_tensor * u   = ggml_mul_mat(ctx, st.pl->m[il], q_t);                                // [D, n_tokens, n_head]
+        kqb = ggml_mul_mat(ctx, st.c, ggml_reshape_2d(ctx, u, D, n_tokens*n_head));              // [n_kv, n_tokens*n_head]
+        kqb = ggml_reshape_3d(ctx, kqb, st.n_kv, n_tokens, n_head);
+    }
+    g.cb(kqb, "kv_mu_kqb", il);
+    g.kv_debias_kqb = kqb;
+}
+
+} // namespace kv_mu
