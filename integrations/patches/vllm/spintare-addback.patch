+@triton.jit
+def _mu_addback_prologue(
+    mu_q_ptr,
+    mu_q_stride_0,
+    mu_q_stride_1,
+    mu_ptr,
+    mu_tab_ptr,
+    query_offset_0,
+    query_offset_1,
+    query_mask_0,
+    query_mask_1,
+    kv_head_idx,
+    offs_t,
+    HEAD_SIZE: tl.constexpr,
+):
+    """Per-program constants of the rotary-centring add-back.
+
+    q . R(p) mu = sum_j A_j cos(p theta_j) + B_j sin(p theta_j) with
+    A_j = q_j mu_j + q_{j+h} mu_{j+h}, B_j = q_{j+h} mu_j - q_j mu_{j+h}
+    (h = HEAD_SIZE / 2, NeoX pairs). Returns A, B (BLOCK_M, h) in fp32, the
+    (TILE_SIZE, h) cos / sin of i theta_j for tile offsets i, and offs_h.
+    """
+    HALF: tl.constexpr = HEAD_SIZE // 2
+    offs_h = tl.arange(0, HALF)
+    q_base = (
+        query_offset_0[:, None].to(tl.int64) * mu_q_stride_0
+        + query_offset_1[:, None] * mu_q_stride_1
+    )
+    q_mask = query_mask_0[:, None] & query_mask_1[:, None]
+    q_lo = tl.load(mu_q_ptr + q_base + offs_h[None, :], mask=q_mask, other=0.0)
+    q_hi = tl.load(mu_q_ptr + q_base + HALF + offs_h[None, :], mask=q_mask, other=0.0)
+    q_lo = q_lo.to(tl.float32)
+    q_hi = q_hi.to(tl.float32)
+    mu_lo = tl.load(mu_ptr + kv_head_idx * HEAD_SIZE + offs_h)
+    mu_hi = tl.load(mu_ptr + kv_head_idx * HEAD_SIZE + HALF + offs_h)
+    mu_A = q_lo * mu_lo[None, :] + q_hi * mu_hi[None, :]
+    mu_B = q_hi * mu_lo[None, :] - q_lo * mu_hi[None, :]
+    tab = offs_t[:, None] * HEAD_SIZE + offs_h[None, :]
+    mu_C = tl.load(mu_tab_ptr + tab)
+    mu_S = tl.load(mu_tab_ptr + tab + HALF)
+    return mu_A, mu_B, mu_C, mu_S, offs_h
+
+
+@triton.jit
+def _mu_addback_tile(
+    mu_A,
+    mu_B,
+    mu_C,
+    mu_S,
+    offs_h,
+    mu_tab_ptr,
+    p0,
+    mu_exempt,
+    mu_bias_scale,
+    HEAD_SIZE: tl.constexpr,
+    offs_t=None,
+    MU_VARIANT: tl.constexpr = 0,
+):
+    """Scaled q . R(p) mu for the tile of keys at positions p0 + i, shape
+    (BLOCK_M, TILE_SIZE); zero for keys stored uncentred. Angle addition from
+    the table row p0: A' = A cos(p0 t) + B sin(p0 t), B' = B cos(p0 t) -
+    A sin(p0 t), bias_i = A' . cos(i t) + B' . sin(i t). The dots run in fp32
+    FMA ("ieee"): the term is large when |mu| is, and TF32 would lose it.
+    MU_VARIANT (PFX1 experiment): bit 0 = tf32x3 dots instead of ieee; bit 1 =
+    reload the tile-offset cos / sin rows here instead of keeping them live in
+    registers across the KV loop."""
+    HALF: tl.constexpr = HEAD_SIZE // 2
+    if MU_VARIANT >= 2:
+        tab = offs_t[:, None] * HEAD_SIZE + offs_h[None, :]
+        mu_C = tl.load(mu_tab_ptr + tab)
+        mu_S = tl.load(mu_tab_ptr + tab + HALF)
+    c0 = tl.load(mu_tab_ptr + p0 * HEAD_SIZE + offs_h)
+    s0 = tl.load(mu_tab_ptr + p0 * HEAD_SIZE + HALF + offs_h)
+    a_t = mu_A * c0[None, :] + mu_B * s0[None, :]
+    b_t = mu_B * c0[None, :] - mu_A * s0[None, :]
+    if MU_VARIANT % 2 == 1:
+        bias = tl.dot(a_t, tl.trans(mu_C), input_precision="tf32x3")
+        bias += tl.dot(b_t, tl.trans(mu_S), input_precision="tf32x3")
+    else:
+        bias = tl.dot(a_t, tl.trans(mu_C), input_precision="ieee")
+        bias += tl.dot(b_t, tl.trans(mu_S), input_precision="ieee")
+    return tl.where(mu_exempt[None, :], 0.0, bias * mu_bias_scale)
+
